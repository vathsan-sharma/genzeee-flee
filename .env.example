# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed variables to the browser.
#
# Form endpoint that emails each inquiry to contact@genzee.ca. Formspree example:
#   https://formspree.io/f/xxxxxxxx
# The endpoint is a public form address, not a secret, so it is safe in the client bundle.
VITE_INQUIRY_ENDPOINT=
